{
  "name": "copyworkcode",
  "displayName": "CopyWorkCode",
  "description": "Review AI-generated code changes by typing them yourself.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copyworkcode.enableWorkspace",
        "title": "Enable in this Workspace",
        "category": "CopyWorkCode"
      },
      {
        "command": "copyworkcode.installAgentHook",
        "title": "Turn On Agent Capture",
        "category": "CopyWorkCode"
      },
      {
        "command": "copyworkcode.uninstallAgentHook",
        "title": "Turn Off Agent Capture",
        "category": "CopyWorkCode"
      },
      {
        "command": "copyworkcode.reviewFile",
        "title": "Review File by Retyping",
        "category": "CopyWorkCode"
      },
      {
        "command": "copyworkcode.skipFile",
        "title": "Mark Reviewed Without Typing",
        "category": "CopyWorkCode",
        "icon": "$(check)"
      },
      {
        "command": "copyworkcode.refresh",
        "title": "Refresh",
        "category": "CopyWorkCode",
        "icon": "$(refresh)"
      },
      {
        "command": "copyworkcode.useGitBaseline",
        "title": "Compare Against Git",
        "category": "CopyWorkCode",
        "icon": "$(git-compare)"
      },
      {
        "command": "copyworkcode.useTrackedBaseline",
        "title": "Compare Against Last Reviewed",
        "category": "CopyWorkCode",
        "icon": "$(bookmark)"
      },
      {
        "command": "copyworkcode.openSettings",
        "title": "Settings",
        "category": "CopyWorkCode",
        "icon": "$(gear)"
      },
      {
        "command": "copyworkcode.skipSection",
        "title": "Skip Current Section",
        "category": "CopyWorkCode"
      },
      {
        "command": "copyworkcode.fillNextLine",
        "title": "Fill Next Line",
        "category": "CopyWorkCode"
      },
      {
        "command": "copyworkcode.fillNextWord",
        "title": "Fill Next Word",
        "category": "CopyWorkCode"
      },
      {
        "command": "copyworkcode.abortReview",
        "title": "Stop Review",
        "category": "CopyWorkCode",
        "icon": "$(stop-circle)"
      },
      {
        "command": "copyworkcode.finishReview",
        "title": "Finish Review",
        "category": "CopyWorkCode",
        "icon": "$(check-all)"
      },
      {
        "command": "copyworkcode.confirmSection",
        "title": "Confirm Deleted Section",
        "category": "CopyWorkCode"
      },
      {
        "command": "copyworkcode.jumpToReview",
        "title": "Jump to Review Position",
        "category": "CopyWorkCode"
      },
      {
        "command": "copyworkcode.showReviewDiff",
        "title": "Show Review Diff",
        "category": "CopyWorkCode",
        "icon": "$(diff)"
      },
      {
        "command": "copyworkcode.reviewNextFile",
        "title": "Review Next File",
        "category": "CopyWorkCode"
      },
      {
        "command": "copyworkcode.focusSection",
        "title": "Start Reviewing This Section",
        "category": "CopyWorkCode"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copyworkcode",
          "title": "CopyWorkCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "copyworkcode": [
        {
          "id": "copyworkcode.debt",
          "name": "AI Changes to Review"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "copyworkcode.debt",
        "contents": "Review AI-made code changes by typing them yourself.\n[Enable in this Workspace](command:copyworkcode.enableWorkspace)",
        "when": "!copyworkcode.enabled"
      },
      {
        "view": "copyworkcode.debt",
        "contents": "Nothing captured yet — no changes have been recorded for this workspace.\nCompare against git to review changes made before capture was on, or turn on capture to collect them from now on.\n[Compare Against Git](command:copyworkcode.useGitBaseline)\n[Turn On Agent Capture](command:copyworkcode.installAgentHook)",
        "when": "copyworkcode.enabled && copyworkcode.debtMode != git && !config.copyworkcode.agentCapture"
      },
      {
        "view": "copyworkcode.debt",
        "contents": "All clear — no changes waiting for review.",
        "when": "copyworkcode.enabled && copyworkcode.debtMode != git && config.copyworkcode.agentCapture"
      },
      {
        "view": "copyworkcode.debt",
        "contents": "Nothing differs from the git revision being compared against.\n[Compare Against Last Reviewed](command:copyworkcode.useTrackedBaseline)",
        "when": "copyworkcode.enabled && copyworkcode.debtMode == git"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "copyworkcode.finishReview",
          "when": "copyworkcode.reviewing && copyworkcode.reviewComplete",
          "group": "navigation@0"
        },
        {
          "command": "copyworkcode.showReviewDiff",
          "when": "copyworkcode.reviewing",
          "group": "navigation@1"
        },
        {
          "command": "copyworkcode.abortReview",
          "when": "copyworkcode.reviewing",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "copyworkcode.useGitBaseline",
          "when": "view == copyworkcode.debt && copyworkcode.enabled && copyworkcode.debtMode != git",
          "group": "navigation@1"
        },
        {
          "command": "copyworkcode.useTrackedBaseline",
          "when": "view == copyworkcode.debt && copyworkcode.enabled && copyworkcode.debtMode == git",
          "group": "navigation@1"
        },
        {
          "command": "copyworkcode.refresh",
          "when": "view == copyworkcode.debt",
          "group": "navigation@2"
        },
        {
          "command": "copyworkcode.openSettings",
          "when": "view == copyworkcode.debt",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "copyworkcode.skipFile",
          "when": "view == copyworkcode.debt && viewItem == copyworkcode.file",
          "group": "inline"
        },
        {
          "command": "copyworkcode.skipFile",
          "when": "view == copyworkcode.debt && viewItem == copyworkcode.file",
          "group": "1_review"
        }
      ],
      "commandPalette": [
        {
          "command": "copyworkcode.installAgentHook",
          "when": "!config.copyworkcode.agentCapture"
        },
        {
          "command": "copyworkcode.uninstallAgentHook",
          "when": "config.copyworkcode.agentCapture"
        },
        {
          "command": "copyworkcode.skipFile",
          "when": "false"
        },
        {
          "command": "copyworkcode.reviewFile",
          "when": "false"
        },
        {
          "command": "copyworkcode.useGitBaseline",
          "when": "copyworkcode.enabled && copyworkcode.debtMode != git"
        },
        {
          "command": "copyworkcode.useTrackedBaseline",
          "when": "copyworkcode.enabled && copyworkcode.debtMode == git"
        },
        {
          "command": "copyworkcode.skipSection",
          "when": "copyworkcode.reviewing"
        },
        {
          "command": "copyworkcode.fillNextLine",
          "when": "copyworkcode.reviewing"
        },
        {
          "command": "copyworkcode.fillNextWord",
          "when": "copyworkcode.reviewing"
        },
        {
          "command": "copyworkcode.abortReview",
          "when": "copyworkcode.reviewing"
        },
        {
          "command": "copyworkcode.confirmSection",
          "when": "copyworkcode.reviewing"
        },
        {
          "command": "copyworkcode.jumpToReview",
          "when": "copyworkcode.reviewing"
        },
        {
          "command": "copyworkcode.showReviewDiff",
          "when": "copyworkcode.reviewing"
        },
        {
          "command": "copyworkcode.finishReview",
          "when": "copyworkcode.reviewing"
        },
        {
          "command": "copyworkcode.reviewNextFile",
          "when": "copyworkcode.enabled"
        },
        {
          "command": "copyworkcode.focusSection",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "copyworkcode.skipSection",
        "key": "alt+s",
        "when": "copyworkcode.reviewing && copyworkcode.sectionActive && copyworkcode.reviewEditorFocused && editorTextFocus"
      },
      {
        "command": "copyworkcode.fillNextLine",
        "key": "alt+f",
        "when": "copyworkcode.reviewing && copyworkcode.sectionActive && copyworkcode.reviewEditorFocused && editorTextFocus"
      },
      {
        "command": "copyworkcode.fillNextWord",
        "key": "right",
        "when": "copyworkcode.guided && editorTextFocus && !suggestWidgetVisible"
      },
      {
        "command": "copyworkcode.fillNextWord",
        "key": "tab",
        "when": "copyworkcode.guided && editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible"
      },
      {
        "command": "copyworkcode.typeEnter",
        "key": "enter",
        "when": "copyworkcode.guided && editorTextFocus && !suggestWidgetVisible"
      },
      {
        "command": "copyworkcode.finishReview",
        "key": "alt+enter",
        "when": "copyworkcode.reviewing && copyworkcode.reviewComplete && editorTextFocus"
      },
      {
        "command": "copyworkcode.abortReview",
        "key": "shift+escape",
        "when": "copyworkcode.reviewing && editorTextFocus"
      },
      {
        "command": "copyworkcode.jumpToReview",
        "key": "alt+j",
        "when": "copyworkcode.reviewing && editorTextFocus"
      },
      {
        "command": "copyworkcode.showReviewDiff",
        "key": "alt+d",
        "when": "copyworkcode.reviewing && editorTextFocus"
      },
      {
        "command": "copyworkcode.reviewNextFile",
        "key": "alt+n",
        "when": "copyworkcode.enabled && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "CopyWorkCode",
      "properties": {
        "copyworkcode.autoSkipGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/package-lock.json",
            "**/*.lock",
            "**/node_modules/**"
          ],
          "description": "Changes to files matching these globs are skipped automatically."
        },
        "copyworkcode.animations": {
          "type": "string",
          "enum": [
            "full",
            "subtle",
            "off"
          ],
          "enumDescriptions": [
            "Typed characters flash and fade into place, filled runs sweep in, and a mismatched keystroke flares and fades.",
            "Typed and filled text fades in, and a mismatch fades out. No flash.",
            "No motion: text appears as soon as it is typed and a mismatch shows a plain flash."
          ],
          "default": "full",
          "description": "How much motion the retype overlay adds while typing."
        },
        "copyworkcode.gitRef": {
          "type": "string",
          "default": "HEAD",
          "description": "Revision the git comparison mode compares the working tree against. Used only while the review queue is set to compare against git."
        },
        "copyworkcode.agentCapture": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Record edits made by Claude Code, so changed files appear in the review queue automatically. Turning this on adds one hook entry to ~/.claude/settings.json; turning it off removes that entry again. The hook only records in workspaces where CopyWorkCode is enabled, and nothing is sent anywhere. Applies to every workspace, because the file it edits is shared by all of them."
        },
        "copyworkcode.freeEditAfter": {
          "type": "number",
          "minimum": 1,
          "default": 10,
          "description": "Consecutive characters that don't match the target before the review concludes you are writing your own code here. That section stops being matched and is recorded as edited; guidance resumes on the next one. A high number effectively keeps guidance on for good."
        },
        "copyworkcode.lockDuringReview": {
          "type": "boolean",
          "default": false,
          "description": "Mark the reviewed file read-only for the session, so only keystrokes that match the target can change it. Off by default: a review happens in a normal editor, and typing something other than the target is a real edit that lands in the file. Turn this on to make a review strictly reproduce the change, with mismatches inserting nothing."
        },
        "copyworkcode.ambientHighlight": {
          "type": "boolean",
          "default": true,
          "description": "Mark the regions of any open file that changed since its review baseline, with a light dim, a gutter icon and a scrollbar mark. Works with no review session, so a file an agent touched reads as changed just by opening it. The file being reviewed is excluded — its own overlay says more."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "demo:seed": "node scripts/seed-demo.js",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"out-test/test/*.test.js\"",
    "test:integration": "tsc -p tsconfig.test.json && node out-test/test-integration/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.5.0"
  }
}
